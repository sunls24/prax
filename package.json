{
  "name": "prax",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal containerized AI agent reachable from messaging channels.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "config": "tsx src/main.ts config",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@inquirer/prompts": "8.7.3",
    "@mozilla/readability": "0.6.0",
    "grammy": "1.46.0",
    "linkedom": "0.18.13",
    "mdast-util-from-markdown": "2.1.0",
    "pino": "10.4.0",
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
