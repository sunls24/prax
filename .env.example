PRAX_CONFIG=./config.json
PRAX_MODEL_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=replace-me
TAVILY_API_KEY=replace-me
LOG_LEVEL=info

# Each secret also supports a file-based alternative, which takes precedence:
# PRAX_MODEL_API_KEY_FILE=/run/secrets/model_api_key
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# TAVILY_API_KEY_FILE=/run/secrets/tavily_api_key
